generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id    String @id @default(uuid())
  name  String @unique
  users User[]

  @@map("roles")
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  roleId    String    @map("role_id")
  role      Role      @relation(fields: [roleId], references: [id])
  auth      Auth?
  favorites Favorite[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

model Auth {
  id                    String    @id @default(uuid())
  userId                String    @unique @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash          String    @map("password_hash")
  refreshToken          String?   @map("refresh_token")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("auth")
}

model TrainType {
  id    String  @id @default(uuid())
  name  String  @unique
  trains Train[]

  @@map("train_types")
}

model Train {
  id          String     @id @default(uuid())
  trainTitle  String     @map("train_title")
  trainTypeId String     @map("train_type_id")
  trainType   TrainType  @relation(fields: [trainTypeId], references: [id], onDelete: Restrict)
  schedules   Schedule[]
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@map("trains")
}

model Schedule {
  id             String     @id @default(uuid())
  trainId        String     @map("train_id")
  train          Train      @relation(fields: [trainId], references: [id], onDelete: Cascade)
  routeName      String     @map("route_name")
  departureDate  DateTime   @map("departure_date")
  finishedDate   DateTime   @map("finished_date")
  stops         String[]    @default([])
  favorites     Favorite[]
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  @@map("schedules")
}

model Favorite {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduleId String   @map("schedule_id")
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([userId, scheduleId])
  @@map("favorites")
}
